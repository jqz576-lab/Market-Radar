# Required for macro liquidity block (FRED)
FRED_API_KEY=

# Optional — BGeometrics token (free tier works without key; register at portal.bgeometrics.com)
BGEOMETRICS_API_KEY=
# BGAPI_TOKEN=

# Optional — post report to Slack (JZ3 Topic 205)
SLACK_WEBHOOK_URL=

# Optional — miner shutdown price model (S21 Pro defaults)
MINER_POWER_W=3250
MINER_ELEC_USD_KWH=0.05
MINER_EFFICIENCY_J_TH=15

# Logging
RADAR_LOG_LEVEL=INFO
RADAR_LOG_DIR=./logs
